[Unit]
Description=PiStreaming (personal streaming server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi
Environment=DATA_DIR=/home/pi/pistream-data
ExecStart=/home/pi/pistreaming
Restart=always
RestartSec=3
StandardOutput=append:/home/pi/pistream.log
StandardError=append:/home/pi/pistream.log

[Install]
WantedBy=multi-user.target
