# Variables de entorno de PiStreaming (detectadas en el binario)
# Copiar a /etc/pistreaming.env con permisos 600 y usar
# EnvironmentFile=/etc/pistreaming.env en el unit de systemd.

# Directorio de datos (DB, caché, biblioteca)
DATA_DIR=/home/pi/pistream-data

# Puerto HTTP
HTTP_PORT=8000

# Interfaz de salida para el tráfico torrent (eth0, wlan0, ...)
EGRESS_BIND=eth0

# Límite de caché en GB
CACHE_MAX_GB=40

# TTL de caché en horas (la tabla settings puede sobrescribirlo)
CACHE_TTL_HOURS=48

# Biblioteca (por defecto <DATA_DIR>/library)
LIBRARY_DIR=/home/pi/pistream-data/library

# Subtítulos online (OpenSubtitles). Sin esto, la función queda deshabilitada.
# OPENSUBTITLES_API_KEY=<TU_API_KEY_AQUI>

# Nivel de log (tracing)
# RUST_LOG=info

# Fichero de configuración alternativo
# PISTREAMING_CONFIG=/etc/pistreaming.toml
